# ============================================================
# GameMind AI — Environment Configuration Template (.env.example)
#
# Instructions / Инструкция:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in the required parameters below.
#    Заполните необходимые параметры ниже.
# ============================================================

# ------------------------------------------------------------
# 1. STEAM CONFIGURATION / НАСТРОЙКИ STEAM
# ------------------------------------------------------------
# Steam Web API Key:
# Obtain your key at: https://steamcommunity.com/dev/apikey
# Получите ваш ключ на странице: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Steam 64-bit ID (numeric ID of your Steam profile):
# Can be found at https://steamid.io/ or your Steam profile URL.
# 64-битный цифровой Steam ID (можно узнать через https://steamid.io/).
STEAM_ID=

# ------------------------------------------------------------
# 2. SUPABASE (CLOUD BACKEND & SOCIAL FEATURES)
#    ОБЛАЧНЫЙ БЭКЕНД И СОЦИАЛЬНЫЕ ФУНКЦИИ
# ------------------------------------------------------------
# Supabase Project URL and Anon/Publishable API Key:
# Found in Project Settings -> API in your Supabase dashboard:
# https://supabase.com/dashboard/project/_/settings/api
# URL проекта и публичный anon-ключ Supabase (раздел Settings -> API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# 3. AI PROVIDERS CONFIGURATION / НАСТРОЙКИ ИИ-ПРОВАЙДЕРОВ
# ------------------------------------------------------------
# Default AI provider (gemini, openai, claude, openrouter, groq, ollama, lmstudio)
# Провайдер по умолчанию для генерации рекомендаций и анализа
AI_PROVIDER=gemini

# Google Gemini API Key:
# Recommended provider. Free tier available.
# Get your API key at: https://aistudio.google.com/app/apikey
# Рекомендуемый провайдер. Получить ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI API Key:
# Get your API key at: https://platform.openai.com/api-keys
# Получить ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude API Key:
# Get your API key at: https://console.anthropic.com/settings/keys
# Получить ключ: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20240620

# OpenRouter API Key:
# Get your API key at: https://openrouter.ai/keys
# Получить ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free

# Groq Cloud API Key:
# High-speed LPU inference. Get your key at: https://console.groq.com/keys
# Сверхбыстрый инференс. Получить ключ: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# ------------------------------------------------------------
# 4. LOCAL AI MODELS / ЛОКАЛЬНЫЕ МОДЕЛИ (OFFLINE / ZERO-COST)
# ------------------------------------------------------------
# Ollama local endpoint and model
# Локальный сервер Ollama (https://ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# LM Studio local endpoint and model
# Локальный сервер LM Studio (https://lmstudio.ai)
LMSTUDIO_URL=http://localhost:1234
LMSTUDIO_MODEL=local-model

# ------------------------------------------------------------
# 5. EXTERNAL GAME METADATA APIS / ВНЕШНИЕ БАЗЫ ДАННЫХ ИГР
# ------------------------------------------------------------
# RAWG Video Games Database API Key:
# Obtain at: https://rawg.io/apidocs
# Получить на странице: https://rawg.io/apidocs
RAWG_API_KEY=

# Twitch / IGDB API credentials:
# Obtain at: https://api-docs.igdb.com/
# Получить на странице: https://api-docs.igdb.com/
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ------------------------------------------------------------
# 6. OPTIONAL ADMIN PRIVILEGES / ОПЦИОНАЛЬНЫЕ ПРАВА АДМИНИСТРАТОРА
# ------------------------------------------------------------
# Steam ID and username to grant administrative actions
# Steam ID и имя пользователя для назначения прав администратора
ADMIN_STEAM_ID=
VITE_ADMIN_STEAM_ID=
VITE_ADMIN_USERNAME=
VITE_ADMIN_NUMERIC_ID=
